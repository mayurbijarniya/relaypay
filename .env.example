# ---------------------------------------------------------------------------
# PayPal (required). Sandbox REST app credentials from developer.paypal.com.
# The app needs Vault ("Save payment methods") enabled.
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Webhook ID from the PayPal dashboard, after registering
# https://<your-app>/api/webhooks/paypal for PAYMENT.CAPTURE.COMPLETED and CUSTOMER.DISPUTE.*
# Optional locally: without it, use "Check PayPal for new disputes".
PAYPAL_WEBHOOK_ID=

# Public URL of this app (Vault return/cancel links and notification links).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Sandbox buyer email. Optional: only used to open sandbox disputes from RelayPay.
# Never put a password here; RelayPay never needs it.
SANDBOX_BUYER_EMAIL=

# RelayPay refuses live PayPal credentials unless this is exactly true.
ALLOW_LIVE=false

# ---------------------------------------------------------------------------
# AI (required for the live agent; without a key a labelled offline fallback runs)
# Any OpenAI-compatible chat completions endpoint with tool calling.
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.subconscious.dev/v1
LLM_MODEL=subconscious/glm-5.3-marathon

# ---------------------------------------------------------------------------
# Hackathon sponsors (optional, each switches on only when set)
# ---------------------------------------------------------------------------
# Channel3: live market price check for the purchasing agent (channel3.ai)
CHANNEL3_API_KEY=
# Zapier: owner alerts. A "Catch Hook" URL that starts with https://hooks.zapier.com/
ZAPIER_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Storage and safety switches
# ---------------------------------------------------------------------------
# Postgres connection string (Render sets this). Empty = local data/db.json.
DATABASE_URL=
# Accept unsigned x-simulator webhook events. Keep false anywhere public.
ALLOW_SIMULATOR=false
# Turn off the demo rate limits (local development only).
DISABLE_RATE_LIMITS=false
# Once Vault is connected it is locked so visitors can't replace it. Set true to reconnect.
ALLOW_VAULT_RESET=false
