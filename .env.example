# ---------------------------------------------------------------------------
# PayPal (required). Sandbox REST app credentials from developer.paypal.com.
# The app needs Vault ("Save payment methods") enabled.
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Webhook ID from the PayPal dashboard, after registering
# https://<your-app>/api/webhooks/paypal for PAYMENT.CAPTURE.COMPLETED and CUSTOMER.DISPUTE.*
# Optional locally: without it, use "Check PayPal for new disputes".
PAYPAL_WEBHOOK_ID=

# Public URL of this app (Vault return/cancel links and notification links).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Sandbox buyer email. Optional: only used to open sandbox disputes from RelayPay.
# Never put a password here; RelayPay never needs it.
SANDBOX_BUYER_EMAIL=

# RelayPay refuses live PayPal credentials unless this is exactly true.
ALLOW_LIVE=false

# ---------------------------------------------------------------------------
# AI (required for the live agent; without a key a labelled offline fallback runs)
# Any OpenAI-compatible chat completions endpoint with tool calling.
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.subconscious.dev/v1
LLM_MODEL=subconscious/glm-5.3-marathon

# ---------------------------------------------------------------------------
# Hackathon sponsors (optional, each switches on only when set)
# ---------------------------------------------------------------------------
# Channel3: live market price check for the purchasing agent (channel3.ai)
CHANNEL3_API_KEY=
# Owner alerts (optional, free): a Discord webhook, a Slack incoming webhook, or an ntfy.sh topic URL
# (https://discord.com/api/webhooks/... | https://hooks.slack.com/services/... | https://ntfy.sh/<topic>).
ALERT_WEBHOOK_URL=
# Still accepted: a Zapier Catch Hook (https://hooks.zapier.com/...)
ZAPIER_WEBHOOK_URL=
# Owner alerts by email through Resend (resend.com). Needs both RESEND_API_KEY and ALERT_EMAIL_TO.
# Without a verified domain Resend only delivers to the email you signed up with.
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Optional sender, e.g. "RelayPay <alerts@your-domain.com>" once the domain is verified in Resend.
ALERT_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Storage and safety switches
# ---------------------------------------------------------------------------
# Postgres connection string (Render sets this). Empty = local data/db.json.
DATABASE_URL=
# Accept unsigned x-simulator webhook events. Keep false anywhere public.
ALLOW_SIMULATOR=false
# Turn off the demo rate limits (local development only).
DISABLE_RATE_LIMITS=false
# Once Vault is connected it is locked so visitors can't replace it. Set true to reconnect.
ALLOW_VAULT_RESET=false

# ---------------------------------------------------------------------------
# Tuning for a shared, hosted demo (all optional)
# ---------------------------------------------------------------------------
# The café's daily spend limit in USD (default 500). The cap in force when a receipt
# is approved is sealed into that receipt.
DAILY_CAP_USD=500
# Scales every rate limit (default 1). Raise it when many judges share one demo.
RATE_LIMIT_MULTIPLIER=1
# Timeout for each PayPal request in milliseconds (default 20000; uploads 45000).
PAYPAL_TIMEOUT_MS=
# Show "Reconcile with PayPal". Needs "Transaction search" enabled on the PayPal app.
ENABLE_RECONCILE=false
# Team-only "Reset the demo" control in Settings (12+ characters). Leave empty to keep it off.
ADMIN_RESET_TOKEN=
